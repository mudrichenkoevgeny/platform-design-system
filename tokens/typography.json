{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "typography": {
    "fontFamily": {
      "primary": { "$value": "PT Sans", "$type": "fontFamily" }
    },
    "fontWeight": {
      "regular": { "$value": 400, "$type": "fontWeight" },
      "bold": { "$value": 700, "$type": "fontWeight" }
    },
    "fontStyle": {
      "normal": { "$value": "normal", "$type": "fontStyle" },
      "italic": { "$value": "italic", "$type": "fontStyle" }
    }
  }
}
